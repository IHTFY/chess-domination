{
  "name": "chess-domination",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "python3 -m http.server 8000 --bind 127.0.0.1",
    "lint": "eslint .",
    "test": "node --test tests/storage.test.js && playwright test",
    "check": "pnpm lint && pnpm check:vendor && pnpm check:sw && pnpm test",
    "check:vendor": "node tools/check-vendor.js",
    "sw:stamp": "node tools/stamp-sw.js",
    "check:sw": "node tools/stamp-sw.js --check",
    "icons:generate": "node tools/generate-icons.js"
  },
  "dependencies": {
    "chessboard-element": "1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.11.0",
    "globals": "17.13.0"
  },
  "packageManager": "pnpm@12.8.1"
}
